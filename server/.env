# ===== Redis =====
REDIS_PASSWORD=openim123
REDIS_PORT=16379

# ===== MinIO =====
MINIO_ROOT_USER=openim
MINIO_ROOT_PASSWORD=openim12345
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ===== Python 服务 =====
PYTHON_SERVICE_PORT=8081
